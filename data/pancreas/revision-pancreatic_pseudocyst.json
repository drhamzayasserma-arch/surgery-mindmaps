      {
        "id": "r2",
        "topic": "Key Pathological / Anatomical Pearl",
        "direction": 1,
        "children": [
          { "id": "r2_1", "topic": "2/3 of pseudocysts arise in the body & tail, and 1/3 arise in the head of the pancreas.", "children": [] },
          { "id": "r2_2", "topic": "CT-guided FNA fluid showing low CA 19-9, high amylase, and negative cytology is diagnostic.", "children": [] },
          { "id": "r2_3", "topic": "Cystogastrostomy is performed for cysts in the body/tail. Cystojejunostomy is used for cysts in the head.", "children": [] },
          { "id": "r2_4", "topic": "External percutaneous drainage is contraindicated in communicating cysts due to the high risk of a pancreaticocutaneous fistula.", "children": [] }
        ]
      }
    ]
