{
  "nodeData": {
    "topic": "🧠 LIVER TRAUMA:\nCOMPREHENSIVE REVISION",
    "id": "root",
    "children": [
      {
        "topic": "📊 1. Background &\nEpidemiology",
        "id": "node_cbe77077",
        "children": [
          {
            "topic": "Incidence",
            "id": "node_d4d70d85",
            "children": [
              {
                "topic": "Most commonly injured organ in\nblunt abdominal trauma overall",
                "id": "node_abdfac37",
                "children": []
              },
              {
                "topic": "Ranks 2nd most common after\nthe spleen in general solid organ injury scales",
                "id": "node_a74e37ff",
                "children": []
              },
              {
                "topic": "~80% of liver injuries associated\nwith other concurrent abdominal trauma",
                "id": "node_ae53465d",
                "children": []
              }
            ]
          },
          {
            "topic": "Predisposing Factors",
            "id": "node_3837648c",
            "children": [
              {
                "topic": "Hepatomegaly (Liver Enlargement):\nIncreases physical surface area, making liver\nmore vulnerable to direct impact",
                "id": "node_47b6ec96",
                "children": []
              },
              {
                "topic": "Diseases of the Liver:\nPathological states (e.g., congested liver)\nincrease tissue fragility and risk of rupture",
                "id": "node_e04cd2b5",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "topic": "🚗 2. Etiology &\nMechanisms of Injury",
        "id": "node_6f1db033",
        "children": [
          {
            "topic": "Closed (Blunt Trauma)",
            "id": "node_6c550fd4",
            "children": [
              {
                "topic": "Direct: Sudden decelerations or direct impact\n(e.g., motor vehicle accidents, steering wheel compression)",
                "id": "node_8d9ac821",
                "children": []
              },
              {
                "topic": "Indirect: Penetration or shearing from\nfractured ribs",
                "id": "node_ea9f5329",
                "children": []
              },
              {
                "topic": "Spontaneous Rupture: Extremely rare,\noccurring in pathologically diseased livers",
                "id": "node_32d8d25b",
                "children": []
              }
            ]
          },
          {
            "topic": "Opened (Penetrating Trauma)",
            "id": "node_86d3e3ee",
            "children": [
              {
                "topic": "Gunshot wounds",
                "id": "node_3ee6a14c",
                "children": []
              },
              {
                "topic": "Stabbing/punctured wounds",
                "id": "node_583bdd91",
                "children": []
              }
            ]
          },
          {
            "topic": "Iatrogenic",
            "id": "node_c184d1f9",
            "children": [
              {
                "topic": "Accidental trauma from invasive medical procedures",
                "id": "node_920aa413",
                "children": []
              },
              {
                "topic": "Classically a percutaneous liver biopsy",
                "id": "node_8d9388d0",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "topic": "📐 3. Pathology &\nAAST Injury Scale",
        "id": "node_805219b6",
        "children": [
          {
            "topic": "Grade I",
            "id": "node_2cda2ce1",
            "children": [
              {
                "topic": "Subcapsular hematoma\n(&lt;10% surface area)",
                "id": "node_4b893ee3",
                "children": []
              },
              {
                "topic": "OR superficial capsular tear/laceration\n(&lt;1 cm depth)",
                "id": "node_446911fa",
                "children": []
              }
            ]
          },
          {
            "topic": "Grade II",
            "id": "node_0168cd2f",
            "children": [
              {
                "topic": "Subcapsular hematoma (10%–50% surface area)",
                "id": "node_14ded995",
                "children": []
              },
              {
                "topic": "OR intraparenchymal hematoma (&lt;10 cm diameter)",
                "id": "node_4df0822b",
                "children": []
              },
              {
                "topic": "OR laceration (1–3 cm parenchymal depth,\n&lt;10 cm length)",
                "id": "node_75ed05a6",
                "children": []
              }
            ]
          },
          {
            "topic": "Grade III",
            "id": "node_0391f9b1",
            "children": [
              {
                "topic": "Subcapsular hematoma (&gt;50% surface area,\nexpanding, or ruptured)",
                "id": "node_9ecd76f9",
                "children": []
              },
              {
                "topic": "OR intraparenchymal hematoma\n(≥10 cm or expanding)",
                "id": "node_702802a5",
                "children": []
              },
              {
                "topic": "OR deep laceration (&gt;3 cm depth)",
                "id": "node_b2d6df26",
                "children": []
              }
            ]
          },
          {
            "topic": "Grade IV",
            "id": "node_f48ff50f",
            "children": [
              {
                "topic": "Lobar parenchymal disruption involving\n25%–75% of a single hepatic lobe",
                "id": "node_29d165d3",
                "children": []
              },
              {
                "topic": "OR involving 1–3 Couinaud segments",
                "id": "node_7f7fed11",
                "children": []
              }
            ]
          },
          {
            "topic": "Grade V",
            "id": "node_4e555693",
            "children": [
              {
                "topic": "Deep parenchymal disruption involving\n&gt;75% of a lobe (shattered liver)",
                "id": "node_bb7e8a0a",
                "children": []
              },
              {
                "topic": "OR juxtahepatic vascular injury\n(retrohepatic inferior vena cava\nor major central hepatic veins)",
                "id": "node_f150b0eb",
                "children": []
              }
            ]
          },
          {
            "topic": "Grade VI",
            "id": "node_c778cb15",
            "children": [
              {
                "topic": "Hepatic avulsion (complete separation of the\nliver from its vascular pedicle—universally fatal)",
                "id": "node_a2894238",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "topic": "🩺 4. Clinical\nPresentation",
        "id": "node_80968f94",
        "children": [
          {
            "topic": "History",
            "id": "node_bcb04fa1",
            "children": [
              {
                "topic": "Blunt trauma to upper abdomen/lower chest",
                "id": "node_2f265428",
                "children": []
              },
              {
                "topic": "Penetrating wound to the right upper quadrant (RUQ)",
                "id": "node_f9c864cb",
                "children": []
              }
            ]
          },
          {
            "topic": "Presentation",
            "id": "node_1fe7570b",
            "children": [
              {
                "topic": "Can range from asymptomatic or clinically masked\nby other severe trauma to obvious shock",
                "id": "node_fdb5c4db",
                "children": []
              }
            ]
          },
          {
            "topic": "Physical Exam Signs",
            "id": "node_cc9b8548",
            "children": [
              {
                "topic": "Systemic: Tachycardia, hypotension, tachypnea,\npallor, and diaphoresis (signs of internal hemorrhage)",
                "id": "node_1bf3d15a",
                "children": []
              },
              {
                "topic": "Local Abdomen: RUQ pain, localized tenderness,\nand muscle guarding/rigidity indicating peritonitis",
                "id": "node_8530f00e",
                "children": []
              },
              {
                "topic": "Skeletal Clues: Fracture of the lower right ribs\nor a visible stab/bullet entry wound",
                "id": "node_5ad49b5a",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "topic": "🔍 5. Diagnostic\nWorkup",
        "id": "node_8464f432",
        "children": [
          {
            "topic": "FAST\n(Focused Assessment with\nSonography for Trauma)",
            "id": "node_139e1d91",
            "children": [
              {
                "topic": "Primary, rapid bedside screening tool\nin unstable patients to identify free\nintraperitoneal fluid",
                "id": "node_f0236b6d",
                "children": []
              }
            ]
          },
          {
            "topic": "Contrast-Enhanced CT Scan",
            "id": "node_6ac8cf2f",
            "children": [
              {
                "topic": "The gold standard and most diagnostic tool\nin hemodynamically stable patients",
                "id": "node_a3bdb4cf",
                "children": []
              },
              {
                "topic": "Extremely accurate for defining lacerations,\nhematoma sizes, and active arterial\ncontrast extravasation (CT \"blush\")",
                "id": "node_4e3773d1",
                "children": []
              }
            ]
          },
          {
            "topic": "Plain X-ray",
            "id": "node_95048af2",
            "children": [
              {
                "topic": "May demonstrate fractures of the lower right ribs",
                "id": "node_415a777e",
                "children": []
              },
              {
                "topic": "And an elevated, fixed right cupola (copula)\nof the diaphragm",
                "id": "node_3c8e78aa",
                "children": []
              }
            ]
          },
          {
            "topic": "DPL\n(Diagnostic Peritoneal Lavage)",
            "id": "node_da3696d0",
            "children": [
              {
                "topic": "Minimally used today (mostly replaced by FAST)",
                "id": "node_a45d2cfa",
                "children": []
              },
              {
                "topic": "Reserved for unconscious, unstable, or\nequivocal patients when FAST is unavailable",
                "id": "node_b47fc220",
                "children": []
              },
              {
                "topic": "Positive findings:",
                "id": "node_c8ce9d82",
                "children": [
                  {
                    "topic": "RBCs &gt; 100,000/ml (hemorrhage)",
                    "id": "node_e4463d2c",
                    "children": []
                  },
                  {
                    "topic": "WBCs &gt; 500/ml (peritonitis)",
                    "id": "node_69e0beee",
                    "children": []
                  },
                  {
                    "topic": "Presence of bile, amylase, or food particles",
                    "id": "node_ecddc41a",
                    "children": []
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "topic": "🏥 6. Treatment\nAlgorithms",
        "id": "node_3d80ad55",
        "children": [
          {
            "topic": "A. Non-Operative (Conservative)\nManagement",
            "id": "node_394ceef8",
            "children": [
              {
                "topic": "Success Rate: Successful in\n~80% of all hepatic injuries",
                "id": "node_bdc3731e",
                "children": []
              },
              {
                "topic": "Indications:",
                "id": "node_04fdc52f",
                "children": [
                  {
                    "topic": "1. Hemodynamically stable patient",
                    "id": "node_76eebebf",
                    "children": []
                  },
                  {
                    "topic": "2. Minor injury grades (Grades I, II, or III)",
                    "id": "node_e8c765a7",
                    "children": []
                  },
                  {
                    "topic": "3. No other intra-abdominal indications for surgery\n(e.g., peritonitis or hollow viscus perforation)",
                    "id": "node_7463bedd",
                    "children": []
                  },
                  {
                    "topic": "4. Immediate availability of serial CT scanning\nand emergency OR facilities",
                    "id": "node_320f85d8",
                    "children": []
                  }
                ]
              },
              {
                "topic": "Methods:",
                "id": "node_3527abc3",
                "children": [
                  {
                    "topic": "Complete bed rest",
                    "id": "node_9792752b",
                    "children": []
                  },
                  {
                    "topic": "IV fluid hydration",
                    "id": "node_fd2b1e9d",
                    "children": []
                  },
                  {
                    "topic": "Broad-spectrum IV prophylactic antibiotics",
                    "id": "node_37185b08",
                    "children": []
                  },
                  {
                    "topic": "Serial clinical/radiological monitoring",
                    "id": "node_31e94a5f",
                    "children": []
                  },
                  {
                    "topic": "Ready consent for immediate exploration\nif clinical deterioration occurs",
                    "id": "node_9ca4fcac",
                    "children": []
                  }
                ]
              },
              {
                "topic": "Adjunct:",
                "id": "node_6d10ebae",
                "children": [
                  {
                    "topic": "Stable patients with localized ongoing arterial bleeding\n(blush on CT) are managed with angioembolization\nvia interventional radiology",
                    "id": "node_905614b4",
                    "children": []
                  }
                ]
              }
            ]
          },
          {
            "topic": "B. Urgent Laparotomy\n(Surgical Exploration)",
            "id": "node_1c130881",
            "children": [
              {
                "topic": "Indications:",
                "id": "node_73b5ed2a",
                "children": [
                  {
                    "topic": "Penetrating abdominal wounds, severe injury grades,\nhemodynamic instability, persistent or recurrent bleeding,\nor associated hollow organ injury",
                    "id": "node_1fb01c60",
                    "children": []
                  }
                ]
              },
              {
                "topic": "Intraoperative Surgical Flow & Escalation:",
                "id": "node_13d6e2de",
                "children": [
                  {
                    "topic": "1. Manual Compression",
                    "id": "node_26e536e5",
                    "children": [
                      {
                        "topic": "Minor/moderate active bleeding managed with\ndirect manual compression for 20 minutes",
                        "id": "node_a1091be8",
                        "children": []
                      },
                      {
                        "topic": "If bleeding stops, suture/ligate as needed",
                        "id": "node_240cf9ac",
                        "children": []
                      }
                    ]
                  },
                  {
                    "topic": "2. Pringle's Maneuver (Inflow Occlusion)",
                    "id": "node_9f45eddc",
                    "children": [
                      {
                        "topic": "Clamping of the hepatoduodenal ligament\n(free border of lesser omentum) to block portal flow",
                        "id": "node_c22b09a7",
                        "children": []
                      },
                      {
                        "topic": "If bleeding stops: Source is inflow-related\n(hepatic artery or portal vein branches);\ntreat with direct suture ligation",
                        "id": "node_80461718",
                        "children": []
                      },
                      {
                        "topic": "If bleeding continues: Source is outflow-related\n(retrohepatic hepatic veins or inferior vena cava)",
                        "id": "node_1a326169",
                        "children": []
                      }
                    ]
                  },
                  {
                    "topic": "3. Lobectomy",
                    "id": "node_d7803a16",
                    "children": [
                      {
                        "topic": "Indicated for a completely shattered lobe",
                        "id": "node_18d37c47",
                        "children": []
                      }
                    ]
                  },
                  {
                    "topic": "4. Damage Control & Peri-hepatic Packing",
                    "id": "node_3800ff82",
                    "children": [
                      {
                        "topic": "If bleeding diffuse, uncontrolled, or outflow-related,\npack tightly with laparotomy pads and\ntemporarily close abdomen",
                        "id": "node_60a0ff15",
                        "children": []
                      },
                      {
                        "topic": "Method: Transfer to ICU for 24–36 (up to 48) hours\nto actively correct the \"lethal triad of death\"\n(coagulopathy, hypothermia, acidosis)\nbefore planned re-exploration",
                        "id": "node_218fe501",
                        "children": []
                      },
                      {
                        "topic": "If packing fails: Source is likely hepatic veins,\nrequiring critical, high-mortality thoraco-abdominal\nincision for direct repair",
                        "id": "node_11cfb7b8",
                        "children": []
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "topic": "⚠️ 7. Post-Traumatic\nComplications",
        "id": "node_0a145bb0",
        "children": [
          {
            "topic": "Early",
            "id": "node_94a209c9",
            "children": [
              {
                "topic": "Severe hemorrhage",
                "id": "node_37b85814",
                "children": []
              },
              {
                "topic": "Hypovolemic shock",
                "id": "node_776cc59a",
                "children": []
              },
              {
                "topic": "Biliary leaks leading to bile peritonitis",
                "id": "node_07f6c7a2",
                "children": []
              }
            ]
          },
          {
            "topic": "Infectious",
            "id": "node_c8a11ef1",
            "children": [
              {
                "topic": "Localized liver abscesses",
                "id": "node_c8bff841",
                "children": []
              },
              {
                "topic": "Subphrenic abscesses",
                "id": "node_eea6f79c",
                "children": []
              }
            ]
          },
          {
            "topic": "Hemobilia",
            "id": "node_19f695d1",
            "children": [
              {
                "topic": "Bleeding into bile ducts secondary to\na hepatic artery pseudoaneurysm",
                "id": "node_465837e2",
                "children": []
              },
              {
                "topic": "Classic clinical triad:",
                "id": "node_01a27b60",
                "children": [
                  {
                    "topic": "RUQ pain",
                    "id": "node_02010663",
                    "children": []
                  },
                  {
                    "topic": "Upper GI bleeding (melena/hematemesis)",
                    "id": "node_f9245b16",
                    "children": []
                  },
                  {
                    "topic": "Obstructive jaundice",
                    "id": "node_fb066bba",
                    "children": []
                  }
                ]
              }
            ]
          },
          {
            "topic": "Delayed Vascular Anomalies",
            "id": "node_d06b1afc",
            "children": [
              {
                "topic": "Development of hepatic artery aneurysms/\npseudoaneurysms",
                "id": "node_c2b31418",
                "children": []
              },
              {
                "topic": "Arteriovenous fistulas (AVF)",
                "id": "node_682bc424",
                "children": []
              }
            ]
          }
        ]
      }
    ],
    "root": true
  }
}