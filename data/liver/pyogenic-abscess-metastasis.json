                ]
              }
            ]
          },
          {
            "topic": "Treatment Strategy",
            "id": "node_abed1d14",
            "children": [
              {
                "topic": "Conservative",
                "id": "node_2b61f67c",
                "children": [
                  {
                    "topic": "IV Antibiotics:\n3rd gen Cephalosporin +\nMetronidazole",
                    "id": "node_fd2ada90",
                    "children": []
                  },
                  {
                    "topic": "Reserved for multiple\nsmall abscesses",
                    "id": "node_61f5f2cf",
                    "children": []
                  }
                ]
              },
              {
                "topic": "CT-Guided Percutaneous\nAspiration",
                "id": "node_4eb3038f",
                "children": [
                  {
                    "topic": "Indicated for abscess",
                    "id": "node_fe38e13d",
                    "children": []
                  }
                ]
              },
              {
                "topic": "CT-Guided Percutaneous\nCatheter Drainage",
                "id": "node_db3339b6",
                "children": [
                  {
                    "topic": "Indicated for abscess > 6 cm",
                    "id": "node_3cba0d0e",
                    "children": []
                  },
                  {
                    "topic": "Uses pig-tail catheter",
                    "id": "node_a631af1c",
                    "children": []
                  },
                  {
                    "topic": "Continue until cavity collapses",
                    "id": "node_fec55935",
                    "children": []
                  }
                ]
              },
              {
                "topic": "Open Surgical Drainage",
                "id": "node_ed536f11",
                "children": [
                  {
                    "topic": "Failed percutaneous drainage",
                    "id": "node_ce97be73",
                    "children": []
                  },
                  {
                    "topic": "Very large or multilocular abscess",
                    "id": "node_b40ad69b",
                    "children": []
                  },
                  {
                    "topic": "Associated surgical pathology\n(e.g., CBD stones requiring extraction)",
                    "id": "node_755bcd71",
                    "children": []
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "topic": "II. Liver Metastasis\n(Secondary Malignant Tumors)",
        "id": "node_e89e6753",
        "children": [
          {
            "topic": "Incidence",
            "id": "node_4bcc3eca",
            "children": [
              {
                "topic": "Metastatic lesions are 20×\nmore common than primary liver tumors",
                "id": "node_32aec4fd",
                "children": []
              },
              {
                "topic": "🏆 Most common overall\nliver tumors",
                "id": "node_8449d9ec",
                "children": []
              }
            ]
          },
          {
            "topic": "Routes of Spread",
            "id": "node_d5684fe3",
            "children": [
              {
                "topic": "Portal Circulation",
                "id": "node_ec5fc18f",
                "children": [
                  {
                    "topic": "Primarily from GIT carcinomas",
                    "id": "node_e967573f",
                    "children": []
                  },
                  {
                    "topic": "e.g., Colorectal, Gastric",
                    "id": "node_418d6b8d",
                    "children": []
                  }
                ]
              },
              {
                "topic": "Hepatic Artery",
                "id": "node_4b201b5f",
                "children": [
                  {
                    "topic": "From distant malignancies",
                    "id": "node_6d3caa8b",
                    "children": []
                  },
                  {
                    "topic": "e.g., Breast, Lung,\nKidney, Ovarian cancers",
                    "id": "node_51ddc31b",
                    "children": []
                  }
                ]
              },
              {
                "topic": "Direct Invasion",
                "id": "node_8d20a5b8",
                "children": [
                  {
                    "topic": "From gallbladder carcinoma",
                    "id": "node_75e008ff",
                    "children": []
                  }
                ]
              }
            ]
          },
          {
            "topic": "Pathology",
            "id": "node_e497c0a6",
            "children": [
              {
                "topic": "Macroscopic Appearance",
                "id": "node_bc3aa3f1",
                "children": [
                  {
