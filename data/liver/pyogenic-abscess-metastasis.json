  "nodeData": {
    "topic": "🦠 Pyogenic Liver Abscess\n& Liver Metastasis",
    "id": "root",
    "children": [
      {
        "topic": "I. Pyogenic Liver Abscess",
        "id": "node_71376f3f",
        "children": [
          {
            "topic": "Pathophysiology &\nRoutes of Infection",
            "id": "node_4eda9a44",
            "children": [
              {
                "topic": "Biliary Tract\n(Cholangitic Abscess)",
                "id": "node_b8ac6118",
                "children": [
                  {
                    "topic": "🏆 Most common route",
                    "id": "node_d53d3c5c",
                    "children": []
                  },
                  {
                    "topic": "Secondary to ascending cholangitis\nfrom biliary obstruction",
                    "id": "node_5c3c2331",
                    "children": []
                  },
                  {
                    "topic": "Most common organism:\nEscherichia coli (E. coli)",
                    "id": "node_e3a598ea",
                    "children": []
                  }
                ]
              },
              {
                "topic": "Portal Vein\n(Pyaemic Abscess)",
                "id": "node_9a7ef460",
                "children": [
                  {
                    "topic": "Spreads from intra-abdominal\ninfectious sites",
                    "id": "node_39e07f6f",
                    "children": []
                  },
                  {
                    "topic": "e.g., Suppurative appendicitis,\ndiverticulitis",
                    "id": "node_9149c52a",
                    "children": []
                  },
                  {
                    "topic": "Organisms: Streptococcus faecalis\n& Anaerobes",
                    "id": "node_e1c68db8",
                    "children": []
                  }
                ]
              },
              {
                "topic": "Hepatic Artery\n(Hematogenous Abscess)",
                "id": "node_a6f17416",
                "children": [
                  {
                    "topic": "Spreads from systemic bacteremia",
                    "id": "node_fd29400f",
                    "children": []
                  },
                  {
                    "topic": "e.g., Bacterial endocarditis,\nrenal infections",
                    "id": "node_35477877",
                    "children": []
                  }
                ]
              },
              {
                "topic": "Idiopathic\n(Cryptogenic)",
                "id": "node_1de27cca",
                "children": [
                  {
                    "topic": "Accounts for 15% of cases",
                    "id": "node_f74a4b1e",
                    "children": []
                  },
                  {
                    "topic": "No identifiable primary source",
                    "id": "node_774d8465",
                    "children": []
                  }
                ]
              }
            ]
          },
          {
            "topic": "Clinical Presentation",
            "id": "node_61ef6d48",
            "children": [
              {
