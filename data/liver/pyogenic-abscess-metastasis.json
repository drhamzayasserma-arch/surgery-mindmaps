                    "id": "node_743410be",
                    "children": []
                  }
                ]
              },
              {
                "topic": "Central Umbilication",
                "id": "node_5bcf4cad",
                "children": [
                  {
                    "topic": "Caused by rapid central\ntumor necrosis",
                    "id": "node_79a30b67",
                    "children": []
                  }
                ]
              }
            ]
          },
          {
