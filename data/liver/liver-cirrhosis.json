{
  "nodeData": {
    "topic": "🫀 Liver Cirrhosis",
    "id": "root",
    "children": [
      {
        "topic": "I. Definition",
        "id": "node_f32893ac",
        "children": [
          {
            "topic": "Diffuse hepatic fibrosis with regenerative nodules replacing normal parenchyma [1][2]",
            "id": "node_194944c8",
            "children": []
          },
          {
            "topic": "Progresses from compensated (asymptomatic) → decompensated (symptomatic) at 5–7%/year [2]",
            "id": "node_d39c7307",
            "children": []
          },
          {
            "topic": "Early fibrosis may be reversible [3]",
            "id": "node_f2291369",
            "children": []
          }
        ]
      },
      {
        "topic": "II. Etiology",
        "id": "node_748e564d",
        "children": [
          {
            "topic": "Alcohol use disorder — ~45% of US cases [4]",
            "id": "node_a0117d79",
            "children": []
          },
          {
            "topic": "NAFLD/NASH — 61.8% of new incident cases, now leading cause of new diagnoses [4]",
            "id": "node_643aaf35",
            "children": []
          },
          {
            "topic": "Hepatitis C — ~41% (often overlapping); now curable with DAAs [4]",
            "id": "node_478b623e",
            "children": []
          },
          {
            "topic": "Hepatitis B — most common cause in endemic regions (Egypt, Asia)",
            "id": "node_8ee77fda",
            "children": []
          },
          {
            "topic": "Autoimmune",
            "id": "node_bb4483f8",
            "children": [
              {
                "topic": "PBC (anti-mitochondrial antibodies)",
                "id": "node_e2425c7c",
                "children": []
              },
              {
                "topic": "PSC",
                "id": "node_a7a5e6d0",
                "children": []
              },
              {
                "topic": "Autoimmune hepatitis",
                "id": "node_0b302c94",
                "children": []
              }
            ]
          },
          {
            "topic": "Metabolic",
