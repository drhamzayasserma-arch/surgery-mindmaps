          }
        ]
      },
      {
        "topic": "VI. Diagnostic Workup",
        "id": "node_6bc975d4",
        "children": [
          {
            "topic": "Elastography ≥15 kPa typically confirms cirrhosis [4]",
            "id": "node_cfcfb4d9",
            "children": []
          },
          {
            "topic": "Noninvasive scores: APRI, FIB-4, FibroTest, NAFLD fibrosis score [3]",
            "id": "node_c628816d",
            "children": []
          },
          {
            "topic": "Labs: CBC, LFTs, PT/INR, albumin, bilirubin; HCV/HBV serologies, ferritin/transferrin sat [3]",
            "id": "node_d9af58c2",
            "children": []
          },
          {
            "topic": "Abdominal ultrasound — first-line imaging",
            "id": "node_ba847891",
            "children": []
          },
          {
            "topic": "Liver biopsy — gold standard but rarely needed if noninvasive tests concordant",
            "id": "node_3069d596",
            "children": []
          }
        ]
      },
      {
        "topic": "VII. Differential Diagnosis",
        "id": "node_eb9316c5",
        "children": [
          {
            "topic": "Budd-Chiari syndrome (hepatic vein thrombosis)",
            "id": "node_5b54c093",
            "children": []
          },
          {
            "topic": "Cardiac hepatopathy / congestive hepatopathy",
            "id": "node_ba819ab8",
            "children": []
          },
          {
            "topic": "Sinusoidal obstruction syndrome (veno-occlusive disease)",
            "id": "node_e44de581",
            "children": []
          },
          {
            "topic": "Non-cirrhotic portal hypertension",
            "id": "node_7c5a610a",
            "children": [
              {
                "topic": "Schistosomiasis",
                "id": "node_26160fa5",
                "children": []
              },
              {
                "topic": "Nodular regenerative hyperplasia",
                "id": "node_5a3be791",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "topic": "VIII. Management / Treatment",
        "id": "node_821369bf",
        "children": [
          {
            "topic": "Etiology-directed: alcohol abstinence, DAAs for HCV, immunosuppression for autoimmune",
            "id": "node_295cd5ef",
            "children": []
          },
          {
            "topic": "Portal hypertension: carvedilol or propranolol — reduced decompensation/death (16% vs 27%) [4]",
            "id": "node_02b9920f",
            "children": []
          },
          {
            "topic": "Ascites: combination aldosterone antagonist + loop diuretic (76% resolution vs 56% sequential); salt restriction [4]",
            "id": "node_acc1da9e",
            "children": []
          },
          {
            "topic": "Hepatic encephalopathy: lactulose (↓ mortality 8.5% vs 14%) ± rifaximin [4]",
            "id": "node_cd42d012",
            "children": []
          },
          {
            "topic": "Hepatorenal syndrome: terlipressin improved reversal (39% vs 18%) [4]",
            "id": "node_1be3ba33",
            "children": []
          },
          {
            "topic": "HCC screening: ultrasound every 6 months [3]",
            "id": "node_1ace48c3",
            "children": []
          },
          {
            "topic": "Liver transplantation for end-stage disease",
            "id": "node_e4baa787",
            "children": []
          }
        ]
      },
      {
        "topic": "IX. Complications",
        "id": "node_0f4e29d2",
        "children": [
          {
            "topic": "Median survival after ascites onset: ~1.1 years; after encephalopathy: ~0.92 years [4]",
            "id": "node_977d068f",
            "children": []
          },
          {
            "topic": "SBP — 11% annual incidence in ascites patients [4]",
            "id": "node_b63ef564",
            "children": []
          },
          {
            "topic": "Hepatorenal syndrome — 8%/year; median survival [4]",
            "id": "node_80a9f49d",
            "children": []
          },
          {
            "topic": "HCC — 1–4%/year; 5-year survival ~20% [4]",
            "id": "node_523f7dd8",
            "children": []
          }
        ]
      },
      {
        "topic": "X. Key Pearls / Red Flags",
        "id": "node_648231be",
        "children": [
          {
            "topic": "Discontinue antihypertensives in decompensated cirrhosis with hypotension; target MAP >82 mmHg [5]",
            "id": "node_108e9ed9",
            "children": []
          },
          {
            "topic": "Only 1 in 3 patients with cirrhosis knows their diagnosis [3]",
            "id": "node_ea8a7c3f",
            "children": []
          },
          {
            "topic": "NAFLD has overtaken HCV as the leading cause of new cirrhosis diagnoses [4]",
            "id": "node_e5242beb",
            "children": []
          },
          {
            "topic": "Micronodular = early alcoholic; macronodular = viral/post-necrotic",
            "id": "node_5b151243",
            "children": []
          }
        ]
      }
