          }
        ]
      },
      {
        "topic": "III. Pathophysiology",
        "id": "node_f395f5ac",
        "children": [
          {
            "topic": "Chronic inflammation → stellate cell activation → collagen deposition → fibrosis",
            "id": "node_ec337327",
            "children": []
          },
          {
            "topic": "Portal hypertension driven by increased intrahepatic resistance + splanchnic vasodilation [5]",
            "id": "node_ea7d22a3",
            "children": []
          },
          {
            "topic": "Splanchnic vasodilation → ↓ effective arterial blood volume → RAAS/SNS activation → sodium/water retention [6][5]",
            "id": "node_9105a173",
            "children": []
          },
          {
            "topic": "Bacterial translocation → systemic inflammation → organ dysfunction [6]",
            "id": "node_30e3cd22",
            "children": []
          }
        ]
      },
      {
        "topic": "IV. Risk Factors",
        "id": "node_92d0e9c8",
        "children": [
          {
            "topic": "Heavy alcohol intake (≥100 g/day historically cited)",
            "id": "node_da389168",
            "children": []
          },
          {
            "topic": "Chronic viral hepatitis (HBV/HCV)",
            "id": "node_15000e81",
            "children": []
          },
          {
            "topic": "Metabolic syndrome / obesity",
            "id": "node_52a0e132",
            "children": []
          },
          {
            "topic": "Prolonged cholestasis",
            "id": "node_a50adf2a",
            "children": []
          }
        ]
      },
      {
        "topic": "V. Clinical Presentation",
        "id": "node_495c8549",
        "children": [
          {
            "topic": "Compensated: often asymptomatic; ~40% diagnosed only at first decompensation [4]",
            "id": "node_a9ee96ad",
            "children": []
          },
          {
            "topic": "Decompensated: ascites, variceal bleeding, hepatic encephalopathy, jaundice",
            "id": "node_494de9cf",
            "children": []
          },
          {
            "topic": "Common symptoms:",
            "id": "node_02a1f0ea",
            "children": [
              {
                "topic": "Muscle cramps (64%)",
                "id": "node_ce6d9ca3",
                "children": []
              },
              {
                "topic": "Poor sleep (63%)",
                "id": "node_738ff9d8",
                "children": []
              },
              {
                "topic": "Pruritus (39%)",
                "id": "node_c7bfd791",
                "children": []
              },
              {
                "topic": "Sexual dysfunction (53%) [4]",
                "id": "node_f4bdc0b6",
                "children": []
              }
            ]
          },
